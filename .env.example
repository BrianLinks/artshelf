# Copy to .env and adjust. All values shown are the defaults.
NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/artshelf.db
SESSION_TTL_HOURS=24
# Must be >= 10 when NODE_ENV=production
BCRYPT_ROUNDS=12
# Max login/register attempts per IP per 15 minutes
LOGIN_RATE_LIMIT_MAX=10
# Uploaded files and limits
UPLOAD_DIR=./data/uploads
# Hard cap per upload; each category may set a lower cap
MAX_UPLOAD_MB=20
# Total storage per user
USER_QUOTA_MB=200
# Days a paid order stays in escrow before it is released to the artist automatically
ESCROW_HOLD_DAYS=7
# Days a delivered commission waits for the client before it is approved automatically
REQUEST_AUTO_APPROVE_DAYS=7
# Built web app (npm run web:build). When this folder has an index.html the API serves it.
WEB_DIST=./web/dist
