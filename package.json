{
  "name": "artshelf",
  "version": "1.1.0",
  "description": "Creative-services marketplace: artists, commissions, licenses, and a local escrow ledger. Runs fully offline.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "migrate": "tsx src/scripts/migrate.ts",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "reindex": "tsx src/scripts/reindex.ts",
    "web:dev": "vite web",
    "web:build": "vite build web",
    "seed": "tsx src/scripts/seed.ts",
    "app": "vite build web && tsx src/server.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.15.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "author": "Brian Okoth",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrianLinks/artshelf.git"
  },
  "bugs": {
    "url": "https://github.com/BrianLinks/artshelf/issues"
  },
  "homepage": "https://github.com/BrianLinks/artshelf#readme"
}
